generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String
  workspaces Workspace[]
}

model Workspace {
  id              String           @id @default(uuid())
  userId          String
  name            String
  syllabusFileUrl String
  rawText         String
  daysToComplete  Int?
  depthLevel      DepthLevel?
  status          WorkspaceStatus  @default(processing)
  topics          Topic[]
  scheduleDays    ScheduleDay[]

  user User @relation(fields: [userId], references: [id])
}

enum WorkspaceStatus {
  processing
  ready
  scheduled
  active
  done
}

enum DepthLevel {
  quick
  moderate
  deep
}

model Topic {
  id               String     @id @default(uuid())
  workspaceId      String
  name             String
  weightagePercent Int
  order            Int
  subtopics        Subtopic[]
  tasks            Task[]

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Subtopic {
  id      String @id @default(uuid())
  topicId String
  name    String

  topic Topic @relation(fields: [topicId], references: [id])
}

model ScheduleDay {
  id          String  @id @default(uuid())
  workspaceId String
  date        DateTime
  tasks       Task[]

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Task {
  id            String      @id @default(uuid())
  topicId       String
  scheduleDayId String
  status        TaskStatus  @default(pending)
  completedAt   DateTime?

  topic       Topic       @relation(fields: [topicId], references: [id])
  scheduleDay ScheduleDay @relation(fields: [scheduleDayId], references: [id])
}

enum TaskStatus {
  pending
  done
  skipped
}
